# ==============================================================================
# DHS Production Environment Template
# ==============================================================================
# Copy to .env.production on deployment server and fill in secret values.
# NEVER commit the filled .env.production file to version control.

# Application Configuration
APP_NAME=DHS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://184.168.125.171:8444

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=error

# Database Configuration (Internal Docker MariaDB)
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=dhs_production
DB_USERNAME=dhs_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Cache, Session, Queue
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Note: Initial Administrator Provisioning is handled ephemerally via DatabaseSeeder 
# during deployment (Step 17) and is NEVER stored in .env or docker-compose metadata.

# Docker Web Port (Internal localhost binding for host reverse proxy)
DOCKER_WEB_PORT=127.0.0.1:8009
